{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "@ng-echarts/chart-library": ["./dist/chart-library"],
      "@ng-echarts/chart-library/bar": ["./dist/chart-library/bar"],
      "@ng-echarts/chart-library/core": ["./dist/chart-library/core"],
      "@ng-echarts/chart-library/line": ["./dist/chart-library/line"],
      "@ng-echarts/chart-library/area": ["./dist/chart-library/area"],
      "@ng-echarts/chart-library/pie": ["./dist/chart-library/pie"],
      "@ng-echarts/chart-library/composed": ["./dist/chart-library/composed"],
      "@ng-echarts/chart-library/radar": ["./dist/chart-library/radar"],
      "@ng-echarts/chart-library/radial": ["./dist/chart-library/radial"],
      "@ng-echarts/chart-library/calendar": ["./dist/chart-library/calendar"],
      "@ng-echarts/chart-library/sankey": ["./dist/chart-library/sankey"]
    },
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": false,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "strict": true
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/chart-library/tsconfig.lib.json"
    },
    {
      "path": "./projects/chart-library/tsconfig.spec.json"
    },
    {
      "path": "./projects/playground/tsconfig.app.json"
    },
    {
      "path": "./projects/playground/tsconfig.spec.json"
    }
  ]
}
