{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "@ng-echarts/chart-library": ["./dist/chart-library"]
    },
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": false,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "strict": true
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/chart-library/tsconfig.lib.json"
    },
    {
      "path": "./projects/chart-library/tsconfig.spec.json"
    },
    {
      "path": "./projects/playground/tsconfig.app.json"
    },
    {
      "path": "./projects/playground/tsconfig.spec.json"
    }
  ]
}
