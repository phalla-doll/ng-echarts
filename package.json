{
  "name": "ng-echarts-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "brand:generate": "node tools/generate-brand-assets.mjs",
    "start": "npm run concepts:prepare && ng serve playground",
    "build": "npm run build:lib && npm run build:playground",
    "build:lib": "ng build chart-library --configuration production",
    "build:playground": "npm run concepts:prepare && ng build playground --configuration production && node tools/prepare-demo.mjs dist/playground",
    "watch:lib": "ng build chart-library --configuration development --watch",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "typecheck": "ngc -p projects/chart-library/tsconfig.lib.prod.json --noEmit && ngc -p projects/playground/tsconfig.app.json --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,html,css,yml}\" .prettierrc",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,json,html,css,yml}\" .prettierrc",
    "pack:lib": "npm run build:lib && npm pack ./dist/chart-library --pack-destination dist",
    "check:consumer": "node tools/check-consumer.mjs",
    "check:docs": "node tools/check-documentation-consumer.mjs",
    "check:ssr": "node tools/check-ssr.mjs",
    "check": "npm run check:workspace && npm run test:browser",
    "serve:ssr": "node dist/playground/server/server.mjs",
    "test:browser": "playwright test",
    "reference:prepare": "npm --prefix tools/reference ci && npm --prefix tools/reference run prepare:source && npm --prefix tools/reference run build",
    "capture:bar": "node tools/capture-bar-reference.mjs",
    "check:runtime": "node tools/check-runtime-consumer.mjs",
    "benchmark:bar": "node tools/benchmark-bar.mjs",
    "benchmark:acceptance": "node tools/benchmark-acceptance.mjs",
    "check:bundle": "node tools/check-bundle-size.mjs",
    "benchmark:line": "node tools/benchmark-line.mjs",
    "capture:line": "node tools/capture-line-reference.mjs",
    "benchmark:area": "node tools/benchmark-area.mjs",
    "capture:area": "node tools/capture-area-reference.mjs",
    "benchmark:pie": "node tools/benchmark-pie.mjs",
    "capture:pie": "node tools/capture-pie-reference.mjs",
    "capture:visual": "node tools/capture-visual-audit.mjs",
    "build:pages": "node tools/build-pages.mjs",
    "check:pages": "node tools/check-pages.mjs",
    "deploy:pages": "node tools/deploy-pages.mjs --preflight && npm run build:pages && npm run check:pages && npm run check:demo-performance && node tools/deploy-pages.mjs",
    "release:prepare": "npm run build:lib && node tools/prepare-local-release.mjs",
    "release:check": "node tools/check-local-release.mjs",
    "release:local": "npm run release:prepare && npm run release:check",
    "benchmark:composed": "node tools/benchmark-acceptance.mjs composed",
    "capture:composed": "node tools/capture-visual-audit.mjs --composed",
    "capture:linked": "node tools/capture-linked-charts.mjs",
    "test:pages-provenance": "node --test tools/pages-provenance.spec.mjs",
    "capture:radar": "node tools/capture-radar.mjs",
    "concepts:generate": "node tools/concept-assets.mjs --generate",
    "concepts:check": "node tools/concept-assets.mjs",
    "test:demo-assets": "node --test tools/demo-assets.spec.mjs",
    "capture:radial": "node tools/capture-radial.mjs",
    "check:demo-performance": "node tools/check-demo-performance.mjs",
    "concepts:prepare": "node tools/concept-assets.mjs --prepare",
    "capture:calendar": "node tools/capture-calendar.mjs",
    "capture:sankey": "node tools/capture-sankey.mjs",
    "capture:premium": "node tools/capture-premium-refinement.mjs",
    "check:workspace": "npm run format:check && npm run test:pages-provenance && npm run test:demo-assets && npm run build && npm run typecheck && npm test && npm run check:consumer && npm run check:docs && npm run check:ssr && npm run check:runtime && npm run check:bundle",
    "check:release-immutability": "node tools/check-release-immutability.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/platform-server": "22.2.6",
    "@angular/router": "22.2.6",
    "@angular/ssr": "22.2.6",
    "echarts": "6.1.0",
    "express": "^5.1.0",
    "highlight.js": "11.12.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.6",
    "@babel/core": "8.0.5",
    "@playwright/test": "1.65.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.0.0",
    "ng-packagr": "22.2.0",
    "prettier": "^3.8.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  }
}
